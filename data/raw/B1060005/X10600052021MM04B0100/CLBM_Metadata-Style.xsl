ication Group</b><table border="1"><tr bgcolor="#C0C0C0"><th>THEME</th><th>CLASS_VAR</th><th>CLASS_CHILD_TF_CODE</th><th>CLASS_PARENT_TF_CODE</th></tr><xsl:for-each select="CLBM/data/table[@name='Parent-child Classification Group']/item"><tr><td><xsl:value-of select="THEME"/></td><td><xsl:value-of select="CLASS_VAR"/></td><td><xsl:value-of select="CLASS_CHILD_TF_CODE"/></td><td><xsl:value-of select="CLASS_PARENT_TF_CODE"/></td></tr></xsl:for-each></table><BR /><b>Notes of Dataset</b><table border="1"><tr bgcolor="#C0C0C0"><th>THEME</th><th>NOTE_DESC_ENG</th><th>NOTE_DESC_CHI</th></tr><xsl:for-each select="CLBM/data/table[@name='Notes of Dataset']/item"><tr><td><xsl:value-of select="THEME"/></td><td><xsl:value-of select="NOTE_DESC_ENG"/></td><td><xsl:value-of select="NOTE_DESC_CHI"/></td></tr></xsl:for-each></table><BR /></body></html></xsl:template></xsl:stylesheet>