<?xml version="1.0"?><xsl:stylesheet version="1.0" xmlns:xsl="http://www.w3.org/1999/XSL/Transform"><xsl:template match="/"><html><body><b>Entity</b><table border="1"><tr bgcolor="#C0C0C0"><th>TAB_NAME</th><th>TAB_DESC_ENG</th><th>TAB_DESC_CHI</th></tr><xsl:for-each select="CLBM/data/table[@name='Entity']/item"><tr><td><xsl:value-of select="TAB_NAME"/></td><td><xsl:value-of select="TAB_DESC_ENG"/></td><td><xsl:value-of select="TAB_DESC_CHI"/></td></tr></xsl:for-each></table><BR /><b>Schema</b><table border="1"><tr bgcolor="#C0C0C0"><th>TAB_NAME</th><th>COL_NAME</th><th>COL_DESC_ENG</th><th>COL_DESC_CHI</th><th>COL_TYPE</th><th>PK</th></tr><xsl:for-each select="CLBM/data/table[@name='Schema']/item"><tr><td><xsl:value-of select="TAB_NAME"/></td><td><xsl:value-of select="COL_NAME"/></td><td><xsl:value-of select="COL_DESC_ENG"/></td><td><xsl:value-of select="COL_DESC_CHI"/></td><td><xsl:value-of select="COL_TYPE"/></td><td><xsl:value-of select="PK"/></td></tr></xsl:for-each></table><BR /><b>Status</b><table border="1"><tr bgcolor="#C0C0C0"><th>STATUS</th><th>STATUS_DESC_ENG</th><th>STATUS_DESC_CHI</th></tr><xsl:for-each select="CLBM/data/table[@name='Status']/item"><tr><td><xsl:value-of select="STATUS"/></td><td><xsl:value-of select="STATUS_DESC_ENG"/></td><td><xsl:value-of select="STATUS_DESC_CHI"/></td></tr></xsl:for-each></table><BR /><b>Reference Per Collect</b><table border="1"><tr bgcolor="#C0C0C0"><th>REF_PER_COLLECT</th><th>REF_PER_COLLECT_DESC_ENG</th><th>REF_PER_COLLECT_DESC_CHI</th><th>REF_PER_COLLECT_RMK_ENG</th><th>REF_PER_COLLECT_RMK_CHI</th></tr><xsl:for-each select="CLBM/data/table[@name='Reference Per Collect']/item"><tr><td><xsl:value-of select="REF_PER_COLLECT"/></td><td><xsl:value-of select="REF_PER_COLLECT_DESC_ENG"/></td><td><xsl:value-of select="REF_PER_COLLECT_DESC_CHI"/></td><td><xsl:value-of select="REF_PER_COLLECT_RMK_ENG"/></td><td><xsl:value-of select="REF_PER_COLLECT_RMK_CHI"/></td></tr></xsl:for-each></table><BR /><b>Special Display</b><ta